var admin_default = ADMIN_VIEW;

// src/main.js
api_default.setBaseUrl(config_default.API_URL);
var TAB_ROUTES = {
  bots: "/bots",
  studio: "/studio",
  profile: "/profile",
  admin: "/admin"
};
function updateTabbar(route) {
  const tabs = document.querySelectorAll(".tabbar .tab");
  tabs.forEach((tab) => {
    const routeKey = tab.dataset.route;
    const targetPath = TAB_ROUTES[routeKey];
    const isActive = route === targetPath || routeKey === "studio" && route.startsWith("/studio");
    tab.classList.toggle("active", isActive);
  });
}
function updateAdminTab() {
  const adminTab = document.getElementById("admin-tab");
  if (!adminTab) return;
  const user = auth_default.getUser();
  const show = !!(user && user.is_admin);
  adminTab.style.display = show ? "flex" : "none";
  if (!show && router_default.getCurrentRoute() === "/admin") {
    router_default.navigate("/bots");
  }
}
function initTabbar() {
  const tabbar = document.querySelector(".tabbar");
  if (!tabbar) return;
  const tabs = tabbar.querySelectorAll(".tab");
  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const route = tab.dataset.route;
      if (route === "bots") router_default.navigate("/bots");
      else if (route === "profile") router_default.navigate("/profile");
      else if (route === "studio") router_default.navigate("/bots");
      else if (route === "admin") router_default.navigate("/admin");
    });
  });
}
async function init() {
  await auth_default.tryAutoLogin();
  updateAdminTab();
  auth_default.onAuthChange(() => {
    updateAdminTab();
  });
  router_default.onBeforeEach(async (path) => {
    const requiresAuth = path.startsWith("/studio");
    if (requiresAuth && !auth_default.isAuthenticated()) {
      router_default.navigate("/profile");
      return false;
    }
    if (path === "/admin" && !auth_default.getUser()?.is_admin) {
      router_default.navigate("/bots");
      return false;
    }
    return true;
  });
  router_default.onAfterEach(() => {
    updateTabbar(router_default.getCurrentRoute());
  });
  router_default.onNotFound(() => {
    const view = document.getElementById("view");
    view.innerHTML = '<div class="empty-state"><div class="empty-state-icon">\u2753</div><div class="empty-state-title">\u0635\u0641\u062D\u0647 \u06CC\u0627\u0641\u062A \u0646\u0634\u062F</div></div>';
    updateTabbar("/");
  });
  router_default.addRoute("/", () => router_default.navigate("/bots"));
  router_default.addRoute("/bots", async () => {
    const view = document.getElementById("view");
    await bots_default.init(view);
  });
  router_default.addRoute("/studio", () => router_default.navigate("/bots"));
  router_default.addRoute("/studio/:bot_id", async (params) => {
    const view = document.getElementById("view");
    await studio_default.init(view, params.bot_id);
  });
  router_default.addRoute("/profile", async () => {
    const view = document.getElementById("view");
    profile_default.init(view);
  });
  router_default.addRoute("/admin", async () => {
    const view = document.getElementById("view");
    if (!auth_default.getUser()?.is_admin) {
      view.innerHTML = '<div class="empty-state"><div class="empty-state-icon">\u{1F6AB}</div><div class="empty-state-title">\u062F\u0633\u062A\u0631\u0633\u06CC \u0645\u062D\u062F\u0648\u062F</div></div>';
    } else {
      admin_default.init(view);
    }
  });
  initTabbar();
  if (window.Telegram?.WebApp?.ready) {
    window.Telegram.WebApp.ready();
  }
  router_default.start();
}
init();
window.GramSaz = {
  API: api_default,
  AUTH: auth_default,
  ROUTER: router_default,
  TOAST: toast_default,
  config: config_default
};
export {
